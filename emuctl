#!/usr/bin/env bash
# emuctl - thin CLI around Google's Android CLI (the `android` binary:
# https://developer.android.com/tools/agents/android-cli) for the Omarchy bar
# widget. There is no daemon here: `android emulator` and `adb` already do the
# real work, so emuctl just resolves the binaries, shells out, and reshapes
# output into JSON the widget can render.
set -euo pipefail

find_android_bin() {
  if [ -n "${EMUCTL_ANDROID:-}" ] && [ -x "${EMUCTL_ANDROID:-}" ]; then
    printf '%s\n' "$EMUCTL_ANDROID"; return 0
  fi
  for p in "$HOME/.local/bin/android" "$HOME/.android/bin/android-cli"; do
    [ -x "$p" ] && { printf '%s\n' "$p"; return 0; }
  done
  command -v android 2>/dev/null || true
}

ANDROID_BIN="$(find_android_bin)"
die() { printf 'emuctl: %s\n' "$*" >&2; exit 1; }
[ -n "$ANDROID_BIN" ] || die "the 'android' CLI is not installed (see https://developer.android.com/tools/agents/android-cli/download)"

sdk_root() { "$ANDROID_BIN" info sdk 2>/dev/null || true; }

find_adb() {
  local root
  root="$(sdk_root)"
  if [ -n "$root" ] && [ -x "$root/platform-tools/adb" ]; then
    printf '%s\n' "$root/platform-tools/adb"; return 0
  fi
  command -v adb 2>/dev/null || true
}

ADB_BIN="$(find_adb)"

# avdmanager isn't part of the `android` CLI itself -- it ships in the
# classic "cmdline-tools" package (`android sdk install cmdline-tools/latest`)
# -- but it's the only thing that knows about real hardware profiles like
# "pixel_6". Without it, profiles fall back to the `android` CLI's generic
# phone/tablet/desktop sizes.
find_avdmanager() {
  local root
  root="$(sdk_root)"
  [ -n "$root" ] || return 0
  local p
  for p in "$root"/cmdline-tools/latest/bin/avdmanager "$root"/cmdline-tools/*/bin/avdmanager; do
    [ -x "$p" ] && { printf '%s\n' "$p"; return 0; }
  done
}

AVDMANAGER_BIN="$(find_avdmanager)"

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# Prints "serial<TAB>avdname" for every running emulator, one per line.
running_map() {
  [ -n "$ADB_BIN" ] || return 0
  "$ADB_BIN" devices 2>/dev/null | awk '/^emulator-/ {print $1}' | while read -r serial; do
    name=$("$ADB_BIN" -s "$serial" emu avd name 2>/dev/null | head -n1 | tr -d '\r')
    [ -n "$name" ] && printf '%s\t%s\n' "$serial" "$name"
  done
}

# ---- commands -----------------------------------------------------------

# `android emulator list --long` is the only source of truth for which AVDs
# exist; its exact column layout isn't a stable contract, so each line is
# parsed defensively (first whitespace-delimited token is the name) rather
# than assuming fixed columns.
cmd_list() {
  local json=false
  [ "${1:-}" = "--json" ] && json=true

  local raw
  raw="$("$ANDROID_BIN" emulator list --long 2>/dev/null || true)"
  local running
  running="$(running_map)"

  if ! $json; then
    printf '%s\n' "$raw"
    return 0
  fi

  printf '['
  local first=true
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    # `--long`'s first line is a "AVD ID   AVD Name   API Level   Status
    # Serial" header, not a device -- without skipping it, an empty AVD list
    # would otherwise render as one fake entry literally named "AVD".
    case "$line" in "AVD ID"*) continue ;; esac
    local name
    name="$(awk '{print $1}' <<< "$line")"
    [ -z "$name" ] && continue
    local status="stopped" port=0
    while IFS=$'\t' read -r s n; do
      if [ "$n" = "$name" ]; then
        status="running"
        port="${s#emulator-}"
        break
      fi
    done <<< "$running"
    $first || printf ','
    first=false
    printf '{"id":"%s","detail":"%s","status":"%s","port":%s}' \
      "$(json_escape "$name")" "$(json_escape "$line")" "$status" "${port:-0}"
  done <<< "$raw"
  printf ']\n'
}

cmd_doctor() {
  local ok=true
  printf 'android CLI: %s\n' "$ANDROID_BIN"
  "$ANDROID_BIN" info 2>&1 | sed 's/^/  /' || ok=false
  if [ -n "$ADB_BIN" ]; then printf '  [ok] adb          %s\n' "$ADB_BIN"; else printf '  [missing] adb\n'; fi
  if [ -n "$AVDMANAGER_BIN" ]; then
    printf '  [ok] avdmanager   %s\n' "$AVDMANAGER_BIN"
  else
    printf '  [optional] avdmanager not found -- run: emuctl enable-devices\n'
    printf '             (installs cmdline-tools so `create` can use real\n'
    printf '             device profiles like pixel_6 instead of medium_phone)\n'
  fi
  if [ -e /dev/kvm ]; then printf '  [ok] /dev/kvm present\n'; else printf '  [missing] /dev/kvm (emulator will run unaccelerated)\n'; fi
  $ok || exit 1
}

cmd_enable_devices() {
  [ -z "$AVDMANAGER_BIN" ] || { printf 'avdmanager already installed: %s\n' "$AVDMANAGER_BIN"; return 0; }
  "$ANDROID_BIN" sdk install cmdline-tools/latest
}

# Without avdmanager: the `android` CLI's own generic size profiles
# (small_phone, medium_phone, ...), one per line.
#
# With avdmanager: real hardware profiles, "id<TAB>Display Name" per line, so
# the widget can show "Pixel 6" while passing "pixel_6" to `create`. Only
# phones/tablets/foldables are listed -- avdmanager also knows about TVs,
# Android Auto head units and Wear faces, which aren't what this widget is for.
# Without avdmanager: bare generic sizes, one per line (no category --
# there's nothing to group, so the widget shows them as a flat list).
#
# With avdmanager: "category<TAB>id<TAB>Display Name" per line. avdmanager's
# device list is Google's own reference hardware -- there is no Samsung/
# OEM/iPhone entry anywhere in it, OEM emulator images simply aren't
# distributed through the Android SDK -- so "category" here means Pixel vs.
# tablet-sized vs. everything else (older Nexus phones, antique QVGA/WVGA
# generics), not a phone brand. TV, Wear OS, Automotive, XR and desktop form
# factors are left out entirely; they're real avdmanager devices but not
# something a "pick a phone" widget should offer.
cmd_profiles() {
  if [ -z "$AVDMANAGER_BIN" ]; then
    "$ANDROID_BIN" emulator create --list-profiles
    return 0
  fi
  "$AVDMANAGER_BIN" list device 2>/dev/null | awk '
    /^id: / {
      id = $0
      sub(/^id: [0-9]+ or "/, "", id)
      sub(/".*/, "", id)
      getline name
      sub(/^ *Name: /, "", name)
      idlc = tolower(id)
      if (idlc ~ /^(automotive|tv_|wearos|xr_|ai_glasses|desktop|resizable)/) next
      if (idlc ~ /tablet/ || idlc == "pixel_c") cat = "tablet"
      else if (idlc ~ /^pixel/) cat = "pixel"
      else cat = "legacy"
      print cat "\t" id "\t" name
    }
  '
}

cmd_start() {
  local name="" cold=false headless=false
  for a in "$@"; do
    case "$a" in
      --cold) cold=true ;;
      --headless) headless=true ;;
      *) name="$a" ;;
    esac
  done
  [ -n "$name" ] || die "usage: emuctl start <avd> [--cold] [--headless]"
  local -a flags=()
  $cold && flags+=(--cold)
  $headless && flags+=(--headless)
  # `android emulator start` blocks until the AVD is fully booted, which is
  # too long to hold the widget's action process open, so it's launched
  # detached and the widget finds out it's up via the next `list` poll.
  nohup "$ANDROID_BIN" emulator start "${flags[@]}" "$name" \
    >/tmp/emuctl-start-"$name".log 2>&1 &
  disown
  printf 'starting %s (pid %s)\n' "$name" "$!"
}

cmd_stop() {
  "$ANDROID_BIN" emulator stop "$@"
}

# Runs in the foreground (no nohup/background) and prints one progress line
# per phase, ending with the bare AVD name as the last line on success --
# that's deliberate: the widget streams this command's stdout live to show
# progress, and reads the final line to know what to auto-start once create
# exits. A system image is a multi-hundred-MB download, so without this a
# caller (human or widget) would stare at a silent terminal for minutes with
# no sign anything is happening.
#
# License prompts are answered with `yes` rather than left to the terminal:
# a backgrounded/non-interactive caller has no stdin to answer them with, and
# the install would otherwise hang or silently decline.
cmd_create() {
  local profile="${1:?usage: emuctl create <device-id-or-profile> [api-level]}"
  local api="${2:-34}"

  if [ -z "$AVDMANAGER_BIN" ]; then
    # No avdmanager: fall back to the `android` CLI's own generic profile
    # (small_phone, medium_phone, ...), which auto-picks everything itself.
    printf 'Creating %s (downloads as needed)...\n' "$profile"
    yes | "$ANDROID_BIN" emulator create "$profile"
    printf '%s\n' "$profile"
    return 0
  fi

  # avdmanager available: create a real device (e.g. "pixel_6", or an older
  # one like "Nexus 7 2013" which has spaces in its device id) instead of a
  # generic size bucket. AVD names can't contain spaces or parens the way
  # device ids sometimes do, so the name is a sanitized copy of the id; the
  # id itself is passed through to -d unmodified. The name is derived rather
  # than random so repeat clicks in the widget are idempotent instead of
  # piling up "pixel_6", "pixel_6_2", ... -- --force lets a second create
  # just recreate it.
  local name
  name="$(printf '%s' "$profile" | tr -cs 'A-Za-z0-9._-' '_')"
  local image_slash="system-images/android-$api/google_apis/x86_64"
  local image_semi="system-images;android-$api;google_apis;x86_64"
  printf 'Downloading system image android-%s google_apis x86_64 (this can take a few minutes)...\n' "$api"
  yes | "$ANDROID_BIN" sdk install "$image_slash"
  printf 'Creating AVD %s (%s)...\n' "$name" "$profile"
  echo no | "$AVDMANAGER_BIN" create avd -n "$name" -k "$image_semi" -d "$profile" --force
  printf '%s\n' "$name"
}

cmd_remove() {
  "$ANDROID_BIN" emulator remove "$@"
}

# ---- SDK / system-image packages ----------------------------------------

cmd_images() {
  local json=false
  [ "${1:-}" = "--json" ] && json=true

  local raw
  raw="$("$ANDROID_BIN" sdk list --all 2>/dev/null || true)"
  local installed_raw
  installed_raw="$("$ANDROID_BIN" sdk list 2>/dev/null || true)"

  local available installed
  available="$(grep -oE 'system-images/[^ ]+' <<< "$raw" | sort -u || true)"
  installed="$(grep -oE 'system-images/[^ ]+' <<< "$installed_raw" | sort -u || true)"

  if ! $json; then
    printf '%s\n' "$available"
    return 0
  fi

  printf '['
  local first=true
  while IFS= read -r pkg; do
    [ -z "$pkg" ] && continue
    local inst=false
    if grep -qxF "$pkg" <<< "$installed"; then inst=true; fi
    $first || printf ','
    first=false
    printf '{"package":"%s","installed":%s}' "$(json_escape "$pkg")" "$inst"
  done <<< "$available"
  printf ']\n'
}

cmd_install() {
  local package="${1:?usage: emuctl install <package>}"
  nohup "$ANDROID_BIN" sdk install "$package" \
    >/tmp/emuctl-install-"$(basename "$package")".log 2>&1 &
  disown
  printf 'installing %s (pid %s)\n' "$package" "$!"
}

usage() {
  cat <<'EOF'
emuctl - manage Android Virtual Devices via the `android` CLI

Usage:
  emuctl doctor                Check that the android CLI / adb / avdmanager / KVM are reachable
  emuctl enable-devices        Install cmdline-tools so `profiles`/`create` use real
                                device ids (pixel_6, pixel_7_pro, ...) instead of
                                generic sizes (medium_phone, ...)
  emuctl list [--json]         List AVDs and whether each is running
  emuctl profiles              List device ids/profiles usable with `create`
  emuctl start <avd> [--cold] [--headless]
  emuctl stop [<avd>]          Stop a running AVD (omit name if only one is running)
  emuctl create <device-id-or-profile> [api-level]
                                Create an AVD (downloads its system image as needed;
                                api-level defaults to 34, only used with avdmanager)
  emuctl remove <avd> [--force]
  emuctl images [--json]       List system-image packages (installed + available)
  emuctl install <package>     android sdk install <package>
EOF
}

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    doctor) cmd_doctor "$@" ;;
    enable-devices) cmd_enable_devices "$@" ;;
    list) cmd_list "$@" ;;
    profiles) cmd_profiles "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    create) cmd_create "$@" ;;
    remove) cmd_remove "$@" ;;
    images) cmd_images "$@" ;;
    install) cmd_install "$@" ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command: $cmd (see --help)" ;;
  esac
}

main "$@"
